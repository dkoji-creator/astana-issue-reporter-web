  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Spirit Catchers: сервер. Появление, ловля, потеря и сохранение улова — только здесь.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Catalog"))
local Map = require(script.Parent:WaitForChild("Map"))
local map = Map.build()

local TEST_PLACE_ID = 99980756426085
-- Закрытый тест: редкие духи луны гарантированы (Studio и тестовый плейс)
local IS_TEST = RunService:IsStudio() or game.PlaceId == TEST_PLACE_ID
local FIRST_MOON, NORMAL_TIME, MOON_TIME = 100, 150, 70
local ALTAR_RANGE, SAFE_RADIUS = 16, 26
local ONI_RADIUS, ONI_WARN = 8, 1.6
local DISTRICT_MAX = { street = 6, canal = 6, garden = 7 }
local WEIGHTS = {
	normal = {
		street = { PaperFox = 60, LanternSpirit = 35, Crane = 5 },
		canal = { PaperFox = 30, Umbrella = 55, LanternSpirit = 15 },
		garden = { Firefly = 50, Kodama = 38, Crane = 12 },
	},
	moon = {
		street = { PaperFox = 40, LanternSpirit = 35, MoonRabbit = 25 },
		canal = { PaperFox = 25, Umbrella = 45, LanternSpirit = 20, Crane = 10 },
		garden = { Firefly = 35, Kodama = 30, Crane = 25, MoonRabbit = 10 },
	},
}

------------------------------------------------------------------ remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(name, class)
	local r = Instance.new(class or "RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local RevealEv = remote("Reveal")
local CatchHoldEv = remote("CatchHold")
local EquipFn = remote("Equip", "RemoteFunction")
local UpgradeFn = remote("Upgrade", "RemoteFunction")
local TutorialEv = remote("TutorialDone")
local StateEv = remote("State")
local SaveResultEv = remote("SaveResult")
local CaughtEv = remote("Caught")
local HitEv = remote("Hit")
local NoticeEv = remote("Notice")
remotes.Parent = ReplicatedStorage

------------------------------------------------------------------ свет
Lighting.ClockTime = 0
Lighting.Brightness = 1.3
Lighting.Ambient = Color3.fromRGB(75, 75, 115)
Lighting.OutdoorAmbient = Color3.fromRGB(90, 90, 135)
Lighting.EnvironmentDiffuseScale = 0.3
local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Name = "Bloom"
bloom.Intensity, bloom.Size, bloom.Threshold = 0.2, 14, 1.6
bloom.Parent = Lighting
local atm = Instance.new("Atmosphere")
atm.Density, atm.Haze, atm.Color, atm.Decay = 0.3, 1.1, Color3.fromRGB(80, 90, 150), Color3.fromRGB(40, 30, 80)
atm.Parent = Lighting

------------------------------------------------------------------ профили (версия 3; сохранения версии 2 переносятся)
local store = nil
pcall(function() store = DataStoreService:GetDataStore("SpiritCatchers_v1") end)

type Profile = {
	version: number, saved: { [string]: number }, firstSaved: { [string]: boolean }, equipped: string?,
	materials: number, lanternLvl: number, jarLvl: number, tutorialDone: boolean, loadFailed: boolean?,
}
local data: { [Player]: Profile } = {}
local jars: { [Player]: { string } } = {}
local holds: { [Player]: number } = {}

local function clampLvl(v)
	return typeof(v) == "number" and math.clamp(math.floor(v), 1, Catalog.MaxLevel) or 1
end

local function migrate(raw): Profile
	local d: Profile = { version = 3, saved = {}, firstSaved = {}, equipped = nil, materials = 0, lanternLvl = 1, jarLvl = 1, tutorialDone = false }
	if typeof(raw) ~= "table" then return d end
	-- v2: { saved, equipped, firstSaved }
	if typeof(raw.saved) == "table" then
		for k, v in raw.saved do
			if Catalog.Kinds[k] and typeof(v) == "number" and v > 0 then
				d.saved[k] = math.floor(v)
				d.firstSaved[k] = true
			end
		end
	end
	if typeof(raw.firstSaved) == "table" then
		for k, v in raw.firstSaved do
			if Catalog.Kinds[k] and v == true then d.firstSaved[k] = true end
		end
	end
	if typeof(raw.equipped) == "string" and (d.saved[raw.equipped] or 0) > 0 then d.equipped = raw.equipped end
	if raw.version == 3 then
		d.materials = typeof(raw.materials) == "number" and math.max(0, math.floor(raw.materials)) or 0
		d.lanternLvl = clampLvl(raw.lanternLvl)
		d.jarLvl = clampLvl(raw.jarLvl)
		d.tutorialDone = raw.tutorialDone == true
	end
	return d
end

local function distinct(d: Profile)
	local n = 0
	for _, v in d.saved do
		if v > 0 then n += 1 end
	end
	return n
end
local function gardenOpen(d: Profile) return distinct(d) >= Catalog.GardenNeed end
local function cap(d: Profile) return Catalog.JarCap[d.jarLvl] end

local function persist(plr)
	local d = data[plr]
	if not (store and d) or d.loadFailed then return false end
	local copy = table.clone(d)
	copy.loadFailed = nil
	local ok, err = pcall(function() store:SetAsync("u" .. plr.UserId, copy) end)
	if not ok then warn("DataStore save failed:", err) end
	return ok
end

local function pushState(plr)
	local d = data[plr]
	if not d then return end
	plr:SetAttribute("LanternLvl", d.lanternLvl)
	plr:SetAttribute("GardenOpen", gardenOpen(d))
	plr:SetAttribute("Companion", d.equipped or "")
	StateEv:FireClient(plr, {
		jar = jars[plr], cap = cap(d), saved = d.saved, equipped = d.equipped, materials = d.materials,
		lanternLvl = d.lanternLvl, jarLvl = d.jarLvl, tutorialDone = d.tutorialDone,
		gardenOpen = gardenOpen(d), distinct = distinct(d), persistent = store ~= nil and not d.loadFailed,
	})
	local ls = plr:FindFirstChild("leaderstats")
	if ls then ls.Spirits.Value = distinct(d) end
end

local function rootOf(plr)
	local c = plr.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return nil end
	return c:FindFirstChild("HumanoidRootPart")
end

------------------------------------------------------------------ фонарь игрока (виден всем)
local function giveLantern(plr, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root then return end
	local p = Instance.new("Part")
	p.Name = "Lantern"
	p.Size, p.Material, p.Color = Vector3.new(0.6, 0.8, 0.6), Enum.Material.Neon, Color3.fromRGB(255, 225, 160)
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.CFrame = root.CFrame * CFrame.new(0.9, 0.3, -0.9)
	local w = Instance.new("Weld")
	w.Name, w.Part0, w.Part1, w.C0 = "Weld", root, p, CFrame.new(0.9, 0.3, -0.9)
	w.Parent = p
	local sl = Instance.new("SpotLight")
	sl.Name, sl.Face, sl.Angle, sl.Brightness = "Beam", Enum.NormalId.Front, 40, 3
	sl.Range = Catalog.LanternRange[data[plr] and data[plr].lanternLvl or 1]
	sl.Color = Color3.fromRGB(255, 240, 200)
	sl.Parent = p
	local pl = Instance.new("PointLight")
	pl.Range, pl.Brightness, pl.Color = 8, 0.8, Color3.fromRGB(255, 220, 160)
	pl.Parent = p
	local att = Instance.new("Attachment")
	att.Name = "BeamAtt"
	att.Parent = p
	p.Parent = char
end

------------------------------------------------------------------ духи
local spiritsFolder = Instance.new("Folder")
spiritsFolder.Name = "Spirits"
spiritsFolder.Parent = workspace

type Spirit = {
	id: number, kind: string, district: string, anchor: Part, revealed: boolean, revealedAt: number,
	born: number, pos: Vector3, dir: Vector3, goal: Vector3, progress: number, tut: boolean,
}
local live: { [number]: Spirit } = {}
local nextId = 0
local moon = { active = false }

local function rnd(a, b) return a + math.random() * (b - a) end

local function zonePoint(district, near: Vector3?, tut: boolean?)
	if district == "street" then
		return Vector3.new(rnd(-14, 14), 0.5, tut and rnd(34, 62) or rnd(34, 124))
	elseif district == "canal" then
		local north = if near then near.Z > -30 else math.random() < 0.5
		return Vector3.new(rnd(-56, 56), 0.5, north and rnd(-18, -11) or rnd(-49, -42))
	end
	return Vector3.new(rnd(-38, 38), 0.5, rnd(-144, -80))
end

local function lift(kind, p: Vector3)
	return Vector3.new(p.X, 0.5 + Catalog.Kinds[kind].height, p.Z)
end

local function newSpirit(kind, district, tut: boolean?)
	nextId += 1
	local info = Catalog.Kinds[kind]
	local a = Instance.new("Part")
	a.Name = "Spirit"
	a.Size, a.Transparency = Vector3.new(1, 1, 1), 1
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
	local att = Instance.new("Attachment")
	att.Name = "Att"
	att.Parent = a
	local start = lift(kind, zonePoint(district, nil, tut))
	local s: Spirit = {
		id = nextId, kind = kind, district = district, anchor = a, revealed = info.move == "swim", revealedAt = os.clock(),
		born = os.clock(), pos = start, dir = Vector3.new(0, 0, -1), goal = lift(kind, zonePoint(district, start, tut)),
		progress = 0, tut = tut == true,
	}
	if info.move == "swim" then
		s.pos = Vector3.new(0, 1.5, -30)
	end
	a.CFrame = CFrame.new(s.pos)
	a:SetAttribute("SpiritId", s.id)
	a:SetAttribute("Kind", kind)
	a:SetAttribute("Revealed", s.revealed)
	a:SetAttribute("Progress", 0)
	a:SetAttribute("Holders", 0)
	a.Parent = spiritsFolder
	live[s.id] = s
	return s
end

local function stopHold(plr)
	local id = holds[plr]
	holds[plr] = nil
	local s = id and live[id]
	if s then
		local b = s.anchor:FindFirstChild("Beam_" .. plr.UserId)
		if b then b:Destroy() end
	end
end

local function removeSpirit(s: Spirit)
	if live[s.id] ~= s then return end
	for plr, id in holds do
		if id == s.id then stopHold(plr) end
	end
	live[s.id] = nil
	s.anchor:Destroy()
end

local function pickKind(district)
	local tbl = WEIGHTS[moon.active and "moon" or "normal"][district]
	local total = 0
	for _, w in tbl do total += w end
	local r = math.random() * total
	for k, w in tbl do
		r -= w
		if r <= 0 then return k end
	end
	return next(tbl)
end

------------------------------------------------------------------ движение
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	-- группы ловцов: несколько игроков на одном духе ловят быстрее, каждый получает свой экземпляр
	local groups: { [number]: { Player } } = {}
	for plr, id in holds do
		local s = live[id]
		local root = rootOf(plr)
		local d = data[plr]
		if not (s and root and d and jars[plr]) or #jars[plr] >= cap(d)
			or (root.Position - s.pos).Magnitude > Catalog.catchRange(s.kind) + 4 then
			if d and jars[plr] and #jars[plr] >= cap(d) then NoticeEv:FireClient(plr, "Банка полна — отнеси улов к алтарю") end
			stopHold(plr)
		else
			groups[id] = groups[id] or {}
			table.insert(groups[id], plr)
		end
	end

	for id, s in live do
		local info = Catalog.Kinds[s.kind]
		local g = groups[id]
		if info.move == "swim" then
			local a = now * 0.3
			s.pos = Vector3.new(math.cos(a) * 22, 1.5, -30 + math.sin(a) * 6)
			s.dir = Vector3.new(-math.sin(a) * 22, 0, math.cos(a) * 6).Unit
		else
			local speed = info.speed * (s.revealed and 0.55 or 1) * (g and 0.3 or 1)
			local to = s.goal - s.pos
			if to.Magnitude < 1 then
				s.goal = lift(s.kind, zonePoint(s.district, s.pos, s.tut))
			else
				s.dir = Vector3.new(to.X, 0, to.Z).Magnitude > 0.05 and Vector3.new(to.X, 0, to.Z).Unit or s.dir
				s.pos += to.Unit * math.min(speed * dt, to.Magnitude)
			end
		end
		s.anchor.CFrame = CFrame.lookAt(s.pos, s.pos + s.dir)

		if g then
			local speed = 0
			for _, p in g do speed += Catalog.LanternSpeed[data[p].lanternLvl] end
			s.progress += dt * speed / Catalog.Rarity[info.rarity].catchTime
		elseif s.progress > 0 then
			s.progress = math.max(0, s.progress - dt * 0.4)
		end
		local shown = s.anchor:GetAttribute("Progress")
		if math.abs(shown - s.progress) > 0.02 or (s.progress == 0 and shown ~= 0) then
			s.anchor:SetAttribute("Progress", math.min(s.progress, 1))
		end
		local n = g and #g or 0
		if s.anchor:GetAttribute("Holders") ~= n then s.anchor:SetAttribute("Holders", n) end

		if g and s.progress >= 1 then
			for _, plr in g do
				table.insert(jars[plr], s.kind)
				CaughtEv:FireClient(plr, s.kind, s.pos, #g)
				pushState(plr)
			end
			removeSpirit(s)
		end
	end
end)

------------------------------------------------------------------ проявление и удержание
RevealEv.OnServerEvent:Connect(function(plr, id)
	local s = typeof(id) == "number" and live[id]
	local root = rootOf(plr)
	local d = data[plr]
	if not (s and root and d) or s.revealed then return end
	if s.district == "garden" and not gardenOpen(d) then return end
	if (root.Position - s.pos).Magnitude > Catalog.LanternRange[d.lanternLvl] + 3 then return end
	s.revealed = true
	s.revealedAt = os.clock()
	s.anchor:SetAttribute("Revealed", true)
end)

CatchHoldEv.OnServerEvent:Connect(function(plr, id)
	stopHold(plr)
	if typeof(id) ~= "number" then return end
	local s = live[id]
	local root = rootOf(plr)
	local d = data[plr]
	if not (s and root and d and s.revealed) then return end
	if #jars[plr] >= cap(d) then
		NoticeEv:FireClient(plr, "Банка полна — отнеси улов к алтарю")
		return
	end
	if (root.Position - s.pos).Magnitude > Catalog.catchRange(s.kind) + 2 then return end
	holds[plr] = id
	local lantern = plr.Character and plr.Character:FindFirstChild("Lantern")
	local att = lantern and lantern:FindFirstChild("BeamAtt")
	if att then
		local b = Instance.new("Beam")
		b.Name = "Beam_" .. plr.UserId
		b.Attachment0, b.Attachment1 = att, s.anchor.Att
		b.Width0, b.Width1, b.LightEmission, b.FaceCamera = 0.4, 1.6, 1, true
		b.Color = ColorSequence.new(Color3.fromRGB(255, 240, 190), Catalog.Rarity[Catalog.Kinds[s.kind].rarity].color)
		b.Transparency = NumberSequence.new(0.2, 0.5)
		b.Parent = s.anchor
	end
end)

------------------------------------------------------------------ появление и исчезновение
local function districtCount(d)
	local n, tutN = 0, 0
	for _, s in live do
		if s.district == d then
			n += 1
			if s.tut and not s.revealed then tutN += 1 end
		end
	end
	return n, tutN
end

newSpirit("PaperFox", "street", true)
newSpirit("PaperFox", "street", true)

task.spawn(function()
	while true do
		local now = os.clock()
		for _, s in live do
			local held = s.anchor:GetAttribute("Holders") > 0
			if not held and not Catalog.Kinds[s.kind].moonOnly then
				if (not s.revealed and now - s.born > 110) or (s.revealed and now - s.revealedAt > 35) then removeSpirit(s) end
			end
		end
		for district, max in DISTRICT_MAX do
			local n, tutN = districtCount(district)
			if district == "street" and tutN < 2 then
				newSpirit("PaperFox", "street", true) -- рядом с алтарём всегда есть лис для обучения
			elseif n < max + (moon.active and 2 or 0) then
				newSpirit(pickKind(district), district)
			end
		end
		task.wait(1.5)
	end
end)

------------------------------------------------------------------ Красная луна и они
local function tweenLight(red)
	local ti = TweenInfo.new(2.5)
	TweenService:Create(Lighting, ti, red and { Ambient = Color3.fromRGB(95, 72, 90), OutdoorAmbient = Color3.fromRGB(105, 78, 98) }
		or { Ambient = Color3.fromRGB(75, 75, 115), OutdoorAmbient = Color3.fromRGB(90, 90, 135) }):Play()
	TweenService:Create(cc, ti, red and { TintColor = Color3.fromRGB(255, 232, 232), Saturation = 0 } or { TintColor = Color3.new(1, 1, 1), Saturation = 0 }):Play()
	TweenService:Create(atm, ti, { Color = red and Color3.fromRGB(190, 45, 55) or Color3.fromRGB(80, 90, 150), Decay = red and Color3.fromRGB(120, 20, 40) or Color3.fromRGB(40, 30, 80) }):Play()
	TweenService:Create(map.moon, ti, { Transparency = red and 0 or 1 }):Play()
end

local function hitPlayer(plr)
	local lost = jars[plr] and #jars[plr] or 0
	jars[plr] = {}
	stopHold(plr)
	local c = plr.Character
	if c then c:PivotTo(map.spawnCF + Vector3.new(0, 3, 0)) end
	HitEv:FireClient(plr, lost)
	pushState(plr)
end

local oniAnchor: Part? = nil
local oniPos = Vector3.new(0, 0.5, 118)
local function oniLoop(a: Part)
	local facing = Vector3.new(0, 0, -1)
	local function place() a.CFrame = CFrame.lookAt(oniPos, oniPos + facing) end
	local function walkTo(goal: Vector3, speed, maxT)
		local t0 = os.clock()
		a:SetAttribute("State", "walk")
		while moon.active and a.Parent and os.clock() - t0 < maxT do
			local d = Vector3.new(goal.X, 0.5, goal.Z) - oniPos
			if d.Magnitude < 1.5 then break end
			facing = d.Unit
			oniPos += facing * math.min(speed * 0.05, d.Magnitude)
			place()
			task.wait(0.05)
		end
	end
	while moon.active and a.Parent do
		local target, best = nil, math.huge
		for _, plr in Players:GetPlayers() do
			local r = rootOf(plr)
			if r and (r.Position - map.altarPos).Magnitude > SAFE_RADIUS and r.Position.Z > -72 and r.Position.Y > -2 then
				local d = (r.Position - oniPos).Magnitude - ((jars[plr] and #jars[plr] > 0) and 40 or 0)
				if d < best then target, best = r, d end
			end
		end
		if not target then
			walkTo(Vector3.new(rnd(-12, 12), 0.5, rnd(40, 120)), 7, 4)
			continue
		end
		-- подходит к игроку
		local tStart = os.clock()
		a:SetAttribute("State", "walk")
		while moon.active and target.Parent and os.clock() - tStart < 3.5 do
			local d = Vector3.new(target.Position.X, 0.5, target.Position.Z) - oniPos
			if d.Magnitude < 10 then break end
			facing = d.Unit
			oniPos += facing * 0.6
			place()
			task.wait(0.05)
		end
		if not (moon.active and target.Parent) then continue end
		local center = Vector3.new(target.Position.X, target.Position.Y - 2.9, target.Position.Z)
		if (center - map.altarPos).Magnitude < SAFE_RADIUS or center.Z < -72 then continue end
		local f = Vector3.new(center.X - oniPos.X, 0, center.Z - oniPos.Z)
		if f.Magnitude > 0.1 then facing = f.Unit end
		place()
		-- круг удара заранее
		a:SetAttribute("State", "windup")
		local ring = Instance.new("Part")
		ring.Name = "OniWarning"
		ring.Shape, ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = Enum.PartType.Cylinder, true, false, false, false
		ring.Material, ring.Color, ring.Transparency = Enum.Material.Neon, Color3.fromRGB(255, 25, 25), 0.3
		ring.Size = Vector3.new(0.15, ONI_RADIUS * 2, ONI_RADIUS * 2)
		ring.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = workspace
		-- белая кромка: круг читается и при красном свете луны
		local edge = ring:Clone()
		edge.Name, edge.Color, edge.Transparency = "OniWarningEdge", Color3.new(1, 1, 1), 0.1
		edge.Size = Vector3.new(0.12, ONI_RADIUS * 2 + 0.8, ONI_RADIUS * 2 + 0.8)
		edge.CFrame = ring.CFrame * CFrame.new(-0.02, 0, 0)
		edge.Parent = workspace
		task.delay(ONI_WARN + 0.05, function() edge:Destroy() end)
		local fill = ring:Clone()
		fill.Transparency, fill.Size, fill.Color = 0.2, Vector3.new(0.2, 0.5, 0.5), Color3.fromRGB(255, 140, 60)
		fill.Parent = workspace
		TweenService:Create(fill, TweenInfo.new(ONI_WARN, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, ONI_RADIUS * 2, ONI_RADIUS * 2) }):Play()
		task.wait(ONI_WARN)
		a:SetAttribute("State", "strike")
		for _, plr in Players:GetPlayers() do
			local r = rootOf(plr)
			if r then
				local d = r.Position - center
				if Vector3.new(d.X, 0, d.Z).Magnitude <= ONI_RADIUS and math.abs(d.Y) < 8 then hitPlayer(plr) end
			end
		end
		fill:Destroy()
		ring.Color, ring.Transparency = Color3.fromRGB(255, 220, 180), 0.2
		TweenService:Create(ring, TweenInfo.new(0.4), { Transparency = 1, Size = Vector3.new(0.1, ONI_RADIUS * 2.6, ONI_RADIUS * 2.6) }):Play()
		task.delay(0.45, function() ring:Destroy() end)
		task.wait(1.3)
	end
end

local function setPhase(active, secs)
	moon.active = active
	workspace:SetAttribute("MoonActive", active)
	workspace:SetAttribute("PhaseEnds", workspace:GetServerTimeNow() + secs)
end

local function startMoon()
	setPhase(true, MOON_TIME)
	tweenLight(true)
	if IS_TEST or math.random() < 0.35 then newSpirit("GoldenCarp", "canal") end
	if IS_TEST or math.random() < 0.5 then newSpirit("MoonRabbit", "street") end
	newSpirit("Crane", "garden")
	local a = Instance.new("Part")
	a.Name = "Oni"
	a.Size, a.Transparency = Vector3.new(1, 1, 1), 1
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
	oniPos = Vector3.new(0, 0.5, 118)
	a.CFrame = CFrame.new(oniPos)
	a:SetAttribute("State", "walk")
	a.Parent = workspace
	oniAnchor = a
	task.spawn(oniLoop, a)
end

local function endMoon()
	setPhase(false, NORMAL_TIME)
	tweenLight(false)
	if oniAnchor then oniAnchor:Destroy() oniAnchor = nil end
	for _, s in live do
		if Catalog.Kinds[s.kind].moonOnly then removeSpirit(s) end
	end
end

task.spawn(function()
	setPhase(false, FIRST_MOON)
	task.wait(FIRST_MOON)
	while true do
		startMoon()
		task.wait(MOON_TIME)
		endMoon()
		task.wait(NORMAL_TIME)
	end
end)

------------------------------------------------------------------ алтарь
local savePrompt = Instance.new("ProximityPrompt")
savePrompt.ActionText, savePrompt.ObjectText = "Сохранить улов", "Алтарь"
savePrompt.HoldDuration, savePrompt.MaxActivationDistance = 0.25, ALTAR_RANGE
savePrompt.RequiresLineOfSight = false
savePrompt.Parent = map.altar

local function doSave(plr)
	local root = rootOf(plr)
	local d = data[plr]
	if not (root and d) then return { ok = false, msg = "Нет персонажа" } end
	if (root.Position - map.altarPos).Magnitude > ALTAR_RANGE + 6 then return { ok = false, msg = "Подойди к алтарю" } end
	local jar = jars[plr]
	if #jar == 0 then return { ok = false, msg = "Банка пуста — сначала поймай духа" } end
	local wasOpen = gardenOpen(d)
	local firsts, gained = {}, 0
	for _, kind in jar do
		if (d.saved[kind] or 0) > 0 then
			gained += Catalog.Rarity[Catalog.Kinds[kind].rarity].material -- дубликат → материал
		end
		d.saved[kind] = (d.saved[kind] or 0) + 1
		if not d.firstSaved[kind] then
			d.firstSaved[kind] = true
			table.insert(firsts, kind)
		end
	end
	d.materials += gained
	local kinds = table.clone(jar)
	jars[plr] = {}
	local persisted = persist(plr)
	pushState(plr)
	return { ok = true, kinds = kinds, firsts = firsts, gained = gained, gardenOpened = not wasOpen and gardenOpen(d), persisted = persisted }
end
savePrompt.Triggered:Connect(function(plr)
	SaveResultEv:FireClient(plr, doSave(plr))
end)

UpgradeFn.OnServerInvoke = function(plr, which)
	local d = data[plr]
	local root = rootOf(plr)
	if not (d and root) then return { ok = false, msg = "Нет персонажа" } end
	if (root.Position - map.altarPos).Magnitude > 30 then return { ok = false, msg = "Улучшения — у алтаря" } end
	local key = which == "lantern" and "lanternLvl" or which == "jar" and "jarLvl" or nil
	if not key then return { ok = false } end
	local lvl = d[key]
	if lvl >= Catalog.MaxLevel then return { ok = false, msg = "Максимальный уровень" } end
	local cost = Catalog.UpgradeCost[lvl]
	if d.materials < cost then return { ok = false, msg = ("Нужно материала: %d"):format(cost) } end
	d.materials -= cost
	d[key] = lvl + 1
	local lantern = plr.Character and plr.Character:FindFirstChild("Lantern")
	if lantern and lantern:FindFirstChild("Beam") then lantern.Beam.Range = Catalog.LanternRange[d.lanternLvl] end
	persist(plr)
	pushState(plr)
	return { ok = true }
end

EquipFn.OnServerInvoke = function(plr, kind)
	local d = data[plr]
	if not d then return false end
	if kind == nil then
		d.equipped = nil
	elseif typeof(kind) == "string" and (d.saved[kind] or 0) > 0 then
		d.equipped = kind
	else
		return false
	end
	persist(plr)
	pushState(plr)
	return true
end

TutorialEv.OnServerEvent:Connect(function(plr)
	local d = data[plr]
	if d and not d.tutorialDone then
		d.tutorialDone = true
		persist(plr)
		pushState(plr)
	end
end)

------------------------------------------------------------------ сторож: сад и вода
task.spawn(function()
	while true do
		for _, plr in Players:GetPlayers() do
			local r = rootOf(plr)
			local d = data[plr]
			if r and d then
				local p = r.Position
				if p.Y < -3.5 then
					-- упал в канал: на ближайший берег
					plr.Character:PivotTo(CFrame.new(math.clamp(p.X, -55, 55), 4, p.Z > -30 and -14 or -46))
				elseif p.Z < -73 and not gardenOpen(d) then
					plr.Character:PivotTo(CFrame.new(math.clamp(p.X, -10, 10), 4, -64))
					NoticeEv:FireClient(plr, ("Сад откроется, когда сохранишь 3 разных духа (%d/3)"):format(distinct(d)))
				end
			end
		end
		task.wait(0.3)
	end
end)

------------------------------------------------------------------ игроки
Players.PlayerAdded:Connect(function(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local v = Instance.new("IntValue")
	v.Name = "Spirits"
	v.Parent = ls
	ls.Parent = plr

	local raw, failed = nil, false
	if store then
		failed = true
		for attempt = 1, 3 do
			local ok, res = pcall(function() return store:GetAsync("u" .. plr.UserId) end)
			if ok then
				raw, failed = res, false
				break
			end
			warn("DataStore load failed:", res)
			task.wait(attempt)
		end
	end
	if not plr.Parent then return end
	local d = migrate(raw)
	d.loadFailed = failed or nil
	data[plr] = d
	jars[plr] = {}
	plr.CharacterAdded:Connect(function(char)
		giveLantern(plr, char)
		task.wait(0.3)
		pushState(plr)
	end)
	if plr.Character then giveLantern(plr, plr.Character) end
	pushState(plr)
	if failed then NoticeEv:FireClient(plr, "Не удалось загрузить сохранение — прогресс этой сессии не запишется") end
end)

Players.PlayerRemoving:Connect(function(plr)
	stopHold(plr)
	persist(plr)
	data[plr], jars[plr] = nil, nil
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, plr in Players:GetPlayers() do persist(plr) end
	end
end)

game:BindToClose(function()
	for _, plr in Players:GetPlayers() do persist(plr) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Map</string>
          <string name="Source"><![CDATA[-- Квартал из трёх районов: улица бумажных фонарей (север), площадь алтаря,
-- канал с мостами и храмовый сад (юг, за воротами-тории).
local Map = {}

local WARM = Color3.fromRGB(255, 160, 80)
local COLD = Color3.fromRGB(110, 210, 255)
local TEAL = Color3.fromRGB(80, 230, 220)
local GARDEN = Color3.fromRGB(170, 255, 170)
local VIOLET = Color3.fromRGB(190, 130, 255)

local world
local function block(name, size, cf, color, mat, props)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Material = mat or Enum.Material.Slate
	for k, v in props or {} do p[k] = v end
	p.Parent = world
	return p
end
local function deco(name, size, cf, color, mat, props)
	props = props or {}
	props.CanCollide = false
	props.CastShadow = false
	return block(name, size, cf, color, mat, props)
end
local function light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness = color, range, brightness
	l.Parent = parent
	return l
end
local function wall(size, pos)
	block("Boundary", size, CFrame.new(pos), Color3.new(), nil, { Transparency = 1, CanQuery = false })
end
local function sign(parent, text, color, face)
	local g = Instance.new("SurfaceGui")
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 20
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.TextScaled, t.Font = UDim2.fromScale(1, 1), 1, true, Enum.Font.GothamBlack
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0.3
	t.Parent = g
	g.Parent = parent
	return t
end
local function billboard(parent, text, color, offset)
	local b = Instance.new("BillboardGui")
	b.Size, b.StudsOffset, b.AlwaysOnTop, b.MaxDistance = UDim2.new(0, 190, 0, 34), offset or Vector3.new(0, 5, 0), true, 600
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.TextScaled, t.Font = UDim2.fromScale(1, 1), 1, true, Enum.Font.GothamBold
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0.25
	t.Parent = b
	b.Parent = parent
end
local function sakura(pos, s)
	s = s or 1
	deco("Trunk", Vector3.new(1.2, 7, 1.2) * s, CFrame.new(pos + Vector3.new(0, 3.5 * s, 0)), Color3.fromRGB(90, 55, 45), Enum.Material.Wood, { CanCollide = true })
	for i, o in { Vector3.new(0, 8, 0), Vector3.new(2, 7, 1), Vector3.new(-2, 7.3, -1), Vector3.new(0.5, 7, -2) } do
		local c = deco("Blossom", Vector3.new(5, 4, 5) * s, CFrame.new(pos + o * s), Color3.fromRGB(255, 170 + i * 8, 210), Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
		if i == 1 then light(c, Color3.fromRGB(255, 180, 220), 12, 0.6) end
	end
end
local function stoneLantern(pos, color)
	block("StoneLantern", Vector3.new(1.4, 2.4, 1.4), CFrame.new(pos + Vector3.new(0, 1.2, 0)), Color3.fromRGB(130, 130, 135), Enum.Material.Concrete)
	local f = deco("LanternFire", Vector3.new(1.2, 1, 1.2), CFrame.new(pos + Vector3.new(0, 2.9, 0)), color, Enum.Material.Neon)
	block("LanternRoof", Vector3.new(2.2, 0.5, 2.2), CFrame.new(pos + Vector3.new(0, 3.6, 0)), Color3.fromRGB(110, 110, 115), Enum.Material.Concrete)
	light(f, color, 16, 1.4)
end
local function torii(z, x, w, h, color)
	for _, sx in { -1, 1 } do
		block("ToriiPillar", Vector3.new(1.4, h, 1.4), CFrame.new(x + sx * w / 2, h / 2, z), color, Enum.Material.SmoothPlastic)
	end
	block("ToriiBeam", Vector3.new(w + 5, 1.2, 1.8), CFrame.new(x, h + 0.6, z), Color3.fromRGB(40, 30, 30))
	block("ToriiBeam2", Vector3.new(w + 2, 0.8, 1.2), CFrame.new(x, h - 2, z), color)
end

function Map.build()
	world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	---------------------------------------------------------------- земля (дорога светлая, вода — яркая)
	block("StreetGround", Vector3.new(40, 1, 106), CFrame.new(0, 0, 83), Color3.fromRGB(115, 100, 92), Enum.Material.Cobblestone)
	block("StreetPath", Vector3.new(10, 0.1, 106), CFrame.new(0, 0.55, 83), Color3.fromRGB(165, 145, 120), Enum.Material.Cobblestone, { CanCollide = false })
	block("PlazaGround", Vector3.new(70, 1, 38), CFrame.new(0, 0, 11), Color3.fromRGB(135, 135, 150), Enum.Material.Slate)
	block("NorthBank", Vector3.new(124, 1, 12), CFrame.new(0, 0, -14), Color3.fromRGB(110, 115, 125), Enum.Material.Slate)
	block("SouthBank", Vector3.new(124, 1, 32), CFrame.new(0, 0, -56), Color3.fromRGB(110, 115, 125), Enum.Material.Slate)
	block("GardenGround", Vector3.new(92, 1, 80), CFrame.new(0, 0, -112), Color3.fromRGB(70, 125, 70), Enum.Material.Grass)
	block("GardenPath", Vector3.new(8, 0.1, 72), CFrame.new(0, 0.55, -112), Color3.fromRGB(175, 165, 140), Enum.Material.Pebble, { CanCollide = false })

	-- канал: вода, дно, стенки и светящаяся кромка, чтобы на телефоне было видно край
	block("Water", Vector3.new(124, 0.4, 20), CFrame.new(0, -2.5, -30), Color3.fromRGB(40, 120, 210), Enum.Material.Glass,
		{ Transparency = 0.25, Reflectance = 0.3, CanCollide = false, CanQuery = false })
	block("CanalBed", Vector3.new(124, 1, 20), CFrame.new(0, -8, -30), Color3.fromRGB(10, 20, 40))
	for _, z in { -19.6, -40.4 } do
		block("CanalWall", Vector3.new(124, 7, 0.8), CFrame.new(0, -4, z), Color3.fromRGB(70, 70, 80))
		deco("WaterEdge", Vector3.new(124, 0.12, 0.5), CFrame.new(0, 0.56, z + (z > -30 and -0.5 or 0.5)), TEAL, Enum.Material.Neon, { Transparency = 0.45 })
	end
	local refl = { WARM, Color3.fromRGB(255, 90, 150), TEAL, Color3.fromRGB(255, 210, 90), VIOLET }
	for i = 1, 22 do
		local x = -58 + (i - 1) * 5.5
		deco("Reflection", Vector3.new(0.9, 0.1, 3 + (i % 4) * 2.5), CFrame.new(x, -3.1, -30 + ((i * 7) % 13) - 6), refl[i % 5 + 1], Enum.Material.Neon, { Transparency = 0.3 })
	end

	---------------------------------------------------------------- границы
	wall(Vector3.new(1, 80, 144), Vector3.new(35.5, 40, 64)) -- улица+площадь
	wall(Vector3.new(1, 80, 144), Vector3.new(-35.5, 40, 64))
	wall(Vector3.new(80, 80, 1), Vector3.new(0, 40, 136.5))
	wall(Vector3.new(27, 80, 1), Vector3.new(49, 40, -8))
	wall(Vector3.new(27, 80, 1), Vector3.new(-49, 40, -8))
	wall(Vector3.new(1, 80, 64), Vector3.new(62.5, 40, -40))
	wall(Vector3.new(1, 80, 64), Vector3.new(-62.5, 40, -40))
	wall(Vector3.new(1, 80, 82), Vector3.new(46.5, 40, -112))
	wall(Vector3.new(1, 80, 82), Vector3.new(-46.5, 40, -112))
	wall(Vector3.new(96, 80, 1), Vector3.new(0, 40, -152.5))

	---------------------------------------------------------------- УЛИЦА БУМАЖНЫХ ФОНАРЕЙ (тёплый свет)
	for z = 42, 130, 22 do
		for _, side in { -1, 1 } do
			local h = 11 + ((z // 22) % 3) * 4
			block("House", Vector3.new(14, h, 18), CFrame.new(side * 27, h / 2, z), Color3.fromRGB(105, 80, 85), Enum.Material.Brick)
			block("Roof", Vector3.new(16, 1, 20), CFrame.new(side * 27, h + 0.5, z), Color3.fromRGB(130, 40, 45), Enum.Material.Slate)
			deco("Window", Vector3.new(0.3, 3, 5), CFrame.new(side * 19.9, 6, z), Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
			deco("Noren", Vector3.new(0.2, 2.5, 4), CFrame.new(side * 19.8, 3, z + 5), Color3.fromRGB(60, 70, 160), Enum.Material.Fabric)
			block("Step", Vector3.new(4, h / 2, 4), CFrame.new(side * 18, h / 4, z + 7.5), Color3.fromRGB(110, 85, 60), Enum.Material.Wood)
		end
	end
	for z = 36, 128, 6 do
		for _, x in { -13, 13 } do
			local lantern = deco("PaperLantern", Vector3.new(1.6, 2, 1.6), CFrame.new(x, 9, z), Color3.fromRGB(255, 140, 70), Enum.Material.Neon, { Shape = Enum.PartType.Ball })
			if (z // 6) % 2 == 0 then light(lantern, WARM, 22, 1.5) end
		end
		deco("String", Vector3.new(26, 0.1, 0.1), CFrame.new(0, 9.9, z), Color3.fromRGB(40, 30, 30))
	end
	-- ориентир: Большой фонарь в конце улицы
	block("GreatLanternPole", Vector3.new(3, 28, 3), CFrame.new(0, 14, 128), Color3.fromRGB(120, 30, 30), Enum.Material.Wood)
	local great = deco("GreatLantern", Vector3.new(11, 13, 11), CFrame.new(0, 34, 128), Color3.fromRGB(255, 130, 60), Enum.Material.Neon, { Shape = Enum.PartType.Ball })
	light(great, WARM, 60, 3)
	billboard(great, "Улица фонарей", WARM, Vector3.new(0, 9, 0))

	---------------------------------------------------------------- ПЛОЩАДЬ И АЛТАРЬ (холодный свет, луч в небо)
	local altarPos = Vector3.new(0, 0.5, 12)
	local altar = block("Altar", Vector3.new(8, 3, 8), CFrame.new(altarPos + Vector3.new(0, 1.5, 0)), Color3.fromRGB(125, 130, 142), Enum.Material.Concrete, { Reflectance = 0 })
	block("AltarStep", Vector3.new(14, 0.6, 14), CFrame.new(altarPos + Vector3.new(0, 0.3, 0)), Color3.fromRGB(105, 110, 122), Enum.Material.Concrete)
	local orb = deco("AltarGlow", Vector3.new(3, 3, 3), CFrame.new(altarPos + Vector3.new(0, 5.5, 0)), COLD, Enum.Material.Neon, { Shape = Enum.PartType.Ball })
	light(orb, COLD, 26, 1.1)
	deco("AltarBeam", Vector3.new(1, 220, 1), CFrame.new(altarPos + Vector3.new(0, 115, 0)), COLD, Enum.Material.Neon, { Transparency = 0.6 })
	for _, x in { -6, 6 } do
		local pillar = deco("AltarPillar", Vector3.new(1, 10, 1), CFrame.new(x, 5.5, altarPos.Z), COLD, Enum.Material.Neon, { Transparency = 0.5 })
		light(pillar, COLD, 14, 0.5)
	end
	billboard(orb, "Алтарь", COLD, Vector3.new(0, 4, 0))
	for _, p in { Vector3.new(-25, 0.5, 24), Vector3.new(25, 0.5, 24), Vector3.new(-25, 0.5, -2), Vector3.new(25, 0.5, -2) } do
		stoneLantern(p, COLD)
	end

	---------------------------------------------------------------- КАНАЛ С МОСТАМИ (бирюзовый свет)
	-- лунный мост — ориентир района (арка, по которой можно пройти)
	local z0, L, N, H = -43, 26, 10, 4
	for i = 1, N do
		local za, zb = z0 + (i - 1) * L / N, z0 + i * L / N
		local ya, yb = H * math.sin(math.pi * (za - z0) / L), H * math.sin(math.pi * (zb - z0) / L)
		local ang = math.atan2(yb - ya, zb - za)
		local len = math.sqrt((zb - za) ^ 2 + (yb - ya) ^ 2) + 0.4
		local cf = CFrame.new(0, (ya + yb) / 2, (za + zb) / 2) * CFrame.Angles(-ang, 0, 0)
		block("MoonBridge", Vector3.new(9, 1, len), cf, Color3.fromRGB(140, 48, 42), Enum.Material.Wood, { Reflectance = 0 })
		for _, x in { -4.4, 4.4 } do
			block("MoonRail", Vector3.new(0.5, 2.4, len), cf * CFrame.new(x, 1.7, 0), Color3.fromRGB(160, 60, 50), Enum.Material.Wood, { Reflectance = 0 })
		end
	end
	for _, z in { -44, -16 } do
		for _, x in { -5, 5 } do
			block("BridgePost", Vector3.new(1, 6, 1), CFrame.new(x, 3.5, z), Color3.fromRGB(140, 48, 42), Enum.Material.Wood)
			local l = deco("BridgeLamp", Vector3.new(1.4, 1.6, 1.4), CFrame.new(x, 7.2, z), WARM, Enum.Material.Neon)
			light(l, WARM, 18, 1.5)
		end
	end
	billboard(world:FindFirstChild("BridgePost"), "Лунный мост", TEAL, Vector3.new(5, 8, 0))
	for _, x in { -32, 32 } do
		block("Bridge", Vector3.new(8, 1, 24), CFrame.new(x, 0, -30), Color3.fromRGB(130, 100, 70), Enum.Material.WoodPlanks)
		for _, sx in { -3.8, 3.8 } do
			block("Rail", Vector3.new(0.4, 2, 24), CFrame.new(x + sx, 1.5, -30), Color3.fromRGB(90, 70, 50), Enum.Material.Wood)
		end
	end
	for x = -56, 56, 16 do
		for _, z in { -19, -41 } do
			block("LampPost", Vector3.new(0.6, 7, 0.6), CFrame.new(x, 3.5, z), Color3.fromRGB(40, 50, 60), Enum.Material.Metal)
			local l = deco("LampHead", Vector3.new(1.2, 1.2, 1.2), CFrame.new(x, 7.3, z), TEAL, Enum.Material.Neon, { Shape = Enum.PartType.Ball })
			light(l, TEAL, 20, 1.3)
		end
	end
	-- ивы у воды
	for _, p in { Vector3.new(-48, 0.5, -12), Vector3.new(46, 0.5, -12), Vector3.new(-45, 0.5, -50), Vector3.new(48, 0.5, -52) } do
		deco("WillowTrunk", Vector3.new(1.2, 8, 1.2), CFrame.new(p + Vector3.new(0, 4, 0)), Color3.fromRGB(70, 55, 45), Enum.Material.Wood, { CanCollide = true })
		deco("Willow", Vector3.new(7, 7, 7), CFrame.new(p + Vector3.new(0, 8.5, 0)), Color3.fromRGB(70, 140, 120), Enum.Material.Grass, { Shape = Enum.PartType.Ball, Transparency = 0.1 })
	end

	---------------------------------------------------------------- ХРАМОВЫЙ САД (зелёный и фиолетовый свет)
	torii(-72, 0, 14, 13, Color3.fromRGB(220, 60, 50))
	block("GardenFence", Vector3.new(54, 8, 1.5), CFrame.new(35, 4, -72), Color3.fromRGB(120, 110, 100), Enum.Material.Brick)
	block("GardenFence", Vector3.new(54, 8, 1.5), CFrame.new(-35, 4, -72), Color3.fromRGB(120, 110, 100), Enum.Material.Brick)
	local barrier = block("GardenBarrier", Vector3.new(14.2, 13, 1), CFrame.new(0, 6.5, -72), VIOLET, Enum.Material.ForceField,
		{ Transparency = 0.2, CanQuery = false })
	local barrierText = sign(barrier, "ЗАКРЫТО: Храмовый сад\nСохрани 3 разных духа", Color3.new(1, 1, 1), Enum.NormalId.Back)
	sign(barrier, "Храмовый сад", Color3.new(1, 1, 1), Enum.NormalId.Front)
	-- пагода — ориентир сада
	for i = 0, 3 do
		local w = 16 - i * 3
		local y = 0.5 + i * 7
		block("Pagoda", Vector3.new(w - 4, 6, w - 4), CFrame.new(0, y + 3, -138), Color3.fromRGB(150, 50, 45), Enum.Material.Wood)
		block("PagodaRoof", Vector3.new(w + 2, 1, w + 2), CFrame.new(0, y + 6.5, -138), Color3.fromRGB(40, 70, 60), Enum.Material.Slate)
		local edge = deco("PagodaEdge", Vector3.new(w + 2.2, 0.25, w + 2.2), CFrame.new(0, y + 6, -138), VIOLET, Enum.Material.Neon)
		if i == 3 then light(edge, VIOLET, 50, 2.5) end
	end
	local spire = deco("PagodaSpire", Vector3.new(0.8, 8, 0.8), CFrame.new(0, 34, -138), Color3.fromRGB(230, 200, 90), Enum.Material.Neon)
	billboard(spire, "Храмовый сад", GARDEN, Vector3.new(0, 6, 0))
	for _, p in { Vector3.new(-25, 0.5, -90), Vector3.new(26, 0.5, -96), Vector3.new(-30, 0.5, -125), Vector3.new(30, 0.5, -130), Vector3.new(-12, 0.5, -108), Vector3.new(16, 0.5, -118) } do
		sakura(p, 1)
	end
	for z = -82, -128, -12 do
		for _, x in { -6, 6 } do
			stoneLantern(Vector3.new(x, 0.5, z), (z // 12) % 2 == 0 and GARDEN or VIOLET)
		end
	end
	block("Pond", Vector3.new(16, 0.3, 12), CFrame.new(-22, 0.4, -110), Color3.fromRGB(60, 140, 200), Enum.Material.Glass, { Transparency = 0.2, CanCollide = false })
	for i = 1, 5 do
		deco("LilyPad", Vector3.new(0.1, 1.6, 1.6), CFrame.new(-28 + i * 2.4, 0.6, -112 + (i % 2) * 3) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(80, 170, 90), nil, { Shape = Enum.PartType.Cylinder })
	end
	local glowArea = deco("GardenFireflies", Vector3.new(80, 1, 70), CFrame.new(0, 4, -112), Color3.new(), nil, { Transparency = 1 })
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(200, 255, 140))
	pe.LightEmission, pe.Rate, pe.Lifetime = 1, 18, NumberRange.new(3, 5)
	pe.Speed, pe.SpreadAngle = NumberRange.new(0.5, 1.5), Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = glowArea

	---------------------------------------------------------------- точка появления
	local spawnCF = CFrame.new(0, 0.6, 24)
	local spawn = Instance.new("SpawnLocation")
	spawn.Size, spawn.CFrame, spawn.Anchored, spawn.Transparency, spawn.CanCollide = Vector3.new(6, 1, 6), spawnCF, true, 1, false
	spawn.Neutral, spawn.Duration = true, 0
	spawn.Parent = world

	-- красная луна (видна во время события)
	local moon = deco("RedMoon", Vector3.new(70, 70, 70), CFrame.new(0, 190, -300), Color3.fromRGB(255, 50, 40), Enum.Material.Neon,
		{ Shape = Enum.PartType.Ball, Transparency = 1 })

	return {
		altar = altar,
		altarPos = altarPos,
		spawnCF = spawnCF,
		barrier = barrier,
		barrierText = barrierText,
		moon = moon,
	}
end

return Map
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="9">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="12">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[-- Клиент: визуал духов и спутников, фонарь с мягким наведением, ловля, обучение, коллекция, улучшения, эффекты.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Spirits = require(Shared:WaitForChild("Spirits"))
local plr = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local spiritsFolder = workspace:WaitForChild("Spirits")
local World = workspace:WaitForChild("World")
local Altar = World:WaitForChild("Altar")
local Barrier = World:WaitForChild("GardenBarrier")
local ALTAR_POS = Altar.Position

local GOLD = Color3.fromRGB(255, 200, 80)
local COLD = Color3.fromRGB(120, 210, 255)

local function root()
	return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

------------------------------------------------------------------ UI-хелперы
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "SpiritHUD", false, true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = plr:WaitForChild("PlayerGui")

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or UDim.new(0, 10)
	c.Parent = o
end
local function maxText(o, n)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = n
	c.Parent = o
end
local function label(text, pos, size, parent, maxSize)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency, l.TextColor3, l.Font, l.TextScaled = 0.3, Color3.new(1, 1, 1), Enum.Font.GothamBold, true
	l.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
	l.Text, l.Position, l.Size = text, pos, size
	corner(l)
	maxText(l, maxSize or 22)
	l.Parent = parent or gui
	return l
end
local function button(text, pos, size, color, parent)
	local b = Instance.new("TextButton")
	b.Text, b.Position, b.Size = text, pos, size
	b.TextScaled, b.Font, b.TextColor3 = true, Enum.Font.GothamBold, Color3.new(1, 1, 1)
	b.BackgroundColor3 = color
	corner(b)
	maxText(b, 22)
	b.Parent = parent or gui
	return b
end

------------------------------------------------------------------ HUD
local jarLabel = label("Банка 0/3", UDim2.new(0, 12, 0, 56), UDim2.new(0, 200, 0, 34))
local infoLabel = label("Материал 0   Сад 0/3", UDim2.new(0, 12, 0, 94), UDim2.new(0, 200, 0, 26), nil, 18)
local collBtn = button("Коллекция", UDim2.new(0, 12, 0, 126), UDim2.new(0, 200, 0, 38), Color3.fromRGB(70, 80, 160))
local upBtn = button("Улучшения", UDim2.new(0, 12, 0, 170), UDim2.new(0, 200, 0, 38), Color3.fromRGB(60, 140, 170))
upBtn.Visible = false
local toast = label("", UDim2.new(0.5, -190, 0, 46), UDim2.new(0, 380, 0, 34))
toast.Visible = false
local banner = label("", UDim2.new(0.5, -150, 0, 8), UDim2.new(0, 300, 0, 32), nil, 20)
local tutPanel = label("", UDim2.new(0.5, -210, 1, -96), UDim2.new(0, 420, 0, 56), nil, 20)
tutPanel.BackgroundColor3, tutPanel.Visible = Color3.fromRGB(30, 70, 110), false
local skipBtn = button("Пропустить", UDim2.new(1, -96, 0, -28), UDim2.new(0, 96, 0, 24), Color3.fromRGB(60, 60, 80), tutPanel)
local districtTitle = label("", UDim2.new(0.5, -170, 0.32, 0), UDim2.new(0, 340, 0, 46), nil, 30)
districtTitle.BackgroundTransparency, districtTitle.Visible = 1, false
districtTitle.TextStrokeTransparency = 0.3

-- компактная кнопка ловли слева от стандартной кнопки прыжка; видна только рядом с доступным духом
local catchBtn = Instance.new("TextButton")
catchBtn.AnchorPoint = Vector2.new(1, 1)
catchBtn.Size, catchBtn.Position = UDim2.new(0, 92, 0, 92), UDim2.new(1, -190, 1, -150)
catchBtn.Text, catchBtn.TextScaled, catchBtn.Font = "ЛОВИТЬ", true, Enum.Font.GothamBlack
catchBtn.BackgroundColor3, catchBtn.TextColor3 = Color3.fromRGB(80, 200, 140), Color3.new(1, 1, 1)
catchBtn.AutoButtonColor, catchBtn.Visible = false, false
corner(catchBtn, UDim.new(1, 0))
local pad = Instance.new("UIPadding")
pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
pad.Parent = catchBtn
local stroke = Instance.new("UIStroke")
stroke.Thickness, stroke.Color, stroke.ApplyStrokeMode = 3, Color3.new(1, 1, 1), Enum.ApplyStrokeMode.Border
stroke.Parent = catchBtn
catchBtn.Parent = gui
local fill = Instance.new("Frame")
fill.BackgroundColor3, fill.BackgroundTransparency = Color3.new(1, 1, 1), 0.45
fill.Size, fill.AnchorPoint, fill.Position, fill.ZIndex = UDim2.new(1, 0, 0, 0), Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), 0
corner(fill, UDim.new(1, 0))
fill.Parent = catchBtn

local vignette = Instance.new("Frame")
vignette.Size, vignette.BackgroundTransparency = UDim2.fromScale(1, 1), 1
vignette.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
vignette.Parent = gui

local hint = Instance.new("BillboardGui")
hint.Size, hint.AlwaysOnTop = UDim2.new(0, 160, 0, 34), true
local hintText = Instance.new("TextLabel")
hintText.Size, hintText.BackgroundTransparency, hintText.TextScaled, hintText.Font = UDim2.fromScale(1, 1), 1, true, Enum.Font.GothamBlack
hintText.TextColor3, hintText.TextStrokeTransparency = Color3.new(1, 1, 1), 0.2
hintText.Parent = hint
hint.Parent = gui

local function showToast(text, secs)
	toast.Text, toast.Visible = text, true
	task.delay(secs or 2.2, function()
		if toast.Text == text then toast.Visible = false end
	end)
end
local function punch(o)
	local s = o.Size
	o.Size = UDim2.new(s.X.Scale, s.X.Offset * 1.15, s.Y.Scale, s.Y.Offset * 1.15)
	TweenService:Create(o, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = s }):Play()
end

------------------------------------------------------------------ окна: коллекция и улучшения
local function modal(title)
	local f = Instance.new("Frame")
	f.AnchorPoint, f.Position, f.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.52), UDim2.fromScale(0.88, 0.8)
	f.BackgroundColor3, f.BackgroundTransparency, f.Visible = Color3.fromRGB(18, 18, 36), 0.05, false
	f.ZIndex = 10
	corner(f, UDim.new(0, 14))
	local t = label(title, UDim2.new(0, 12, 0, 6), UDim2.new(1, -70, 0, 32), f, 26)
	t.BackgroundTransparency, t.TextXAlignment = 1, Enum.TextXAlignment.Left
	local close = button("X", UDim2.new(1, -48, 0, 6), UDim2.new(0, 40, 0, 34), Color3.fromRGB(160, 50, 60), f)
	close.Activated:Connect(function() f.Visible = false end)
	f.Parent = gui
	return f
end

local collFrame = modal("Коллекция духов")
local grid = Instance.new("ScrollingFrame")
grid.Position, grid.Size = UDim2.new(0, 8, 0, 44), UDim2.new(1, -16, 1, -52)
grid.BackgroundTransparency, grid.ScrollBarThickness = 1, 6
grid.AutomaticCanvasSize, grid.CanvasSize = Enum.AutomaticSize.Y, UDim2.new()
grid.Parent = collFrame
local layout = Instance.new("UIGridLayout")
layout.CellSize, layout.CellPadding = UDim2.new(0.25, -8, 0, 150), UDim2.new(0, 8, 0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = grid

local upFrame = modal("Улучшения у алтаря")
upFrame.Size = UDim2.fromScale(0.6, 0.62)
local upInfo = label("", UDim2.new(0, 12, 0, 44), UDim2.new(1, -24, 0, 26), upFrame, 18)
upInfo.BackgroundTransparency = 1
local function upRow(y)
	local l = label("", UDim2.new(0, 12, 0, y), UDim2.new(0.62, -12, 0, 56), upFrame, 18)
	local b = button("", UDim2.new(0.62, 8, 0, y), UDim2.new(0.38, -20, 0, 56), Color3.fromRGB(70, 160, 100), upFrame)
	return l, b
end
local lanternRow, lanternBtn = upRow(78)
local jarRow, jarBtn = upRow(142)

------------------------------------------------------------------ состояние игрока
local state = { jar = {}, cap = 3, saved = {}, materials = 0, lanternLvl = 1, jarLvl = 1, tutorialDone = true, gardenOpen = false, distinct = 0 }
local cards = {}

local function refreshCollection()
	for i, kind in Catalog.Order do
		local info = Catalog.Kinds[kind]
		local rar = Catalog.Rarity[info.rarity]
		local c = cards[kind]
		if not c then
			c = {}
			local f = Instance.new("Frame")
			f.LayoutOrder, f.BackgroundColor3 = i, Color3.fromRGB(35, 35, 60)
			corner(f)
			local st = Instance.new("UIStroke")
			st.Thickness, st.Color = 2, rar.color
			st.Parent = f
			c.icon = label("", UDim2.new(0, 4, 0, 4), UDim2.new(1, -8, 0, 40), f, 34)
			c.icon.BackgroundTransparency = 1
			c.name = label("", UDim2.new(0, 4, 0, 44), UDim2.new(1, -8, 0, 22), f, 16)
			c.name.BackgroundTransparency = 1
			c.rar = label(rar.name, UDim2.new(0, 4, 0, 64), UDim2.new(1, -8, 0, 16), f, 13)
			c.rar.BackgroundTransparency, c.rar.TextColor3 = 1, rar.color
			c.hint = label("", UDim2.new(0, 4, 0, 80), UDim2.new(1, -8, 0, 32), f, 12)
			c.hint.BackgroundTransparency, c.hint.TextColor3, c.hint.Font = 1, Color3.fromRGB(200, 200, 220), Enum.Font.Gotham
			c.equip = button("", UDim2.new(0, 6, 1, -34), UDim2.new(1, -12, 0, 28), Color3.fromRGB(200, 60, 70), f)
			c.equip.Activated:Connect(function()
				remotes.Equip:InvokeServer(state.equipped ~= kind and kind or nil)
			end)
			f.Parent = grid
			cards[kind] = c
		end
		local n = state.saved[kind] or 0
		c.icon.Text = n > 0 and info.icon or "?"
		c.name.Text = n > 0 and (info.name .. "  ×" .. n) or "???"
		c.hint.Text = (n > 0 and "Где: " or "Ищи: ") .. info.hint
		c.equip.Visible = n > 0
		c.equip.Text = state.equipped == kind and "Снять" or "Экипировать"
		c.equip.BackgroundColor3 = state.equipped == kind and Color3.fromRGB(90, 90, 110) or Color3.fromRGB(200, 60, 70)
	end
end

local function refreshUpgrades()
	upInfo.Text = ("Материал: %d   (дубликаты при сохранении дают материал)"):format(state.materials)
	local function row(lbl, btn, lvl, cur, nxt)
		if lvl >= Catalog.MaxLevel then
			lbl.Text = cur .. "  (макс.)"
			btn.Text, btn.AutoButtonColor, btn.BackgroundColor3 = "Готово", false, Color3.fromRGB(80, 80, 90)
		else
			local cost = Catalog.UpgradeCost[lvl]
			lbl.Text = cur .. "  ->  " .. nxt
			btn.Text = ("Улучшить: %d"):format(cost)
			btn.BackgroundColor3 = state.materials >= cost and Color3.fromRGB(70, 160, 100) or Color3.fromRGB(90, 90, 100)
		end
	end
	local l = state.lanternLvl
	row(lanternRow, lanternBtn, l, ("Фонарь ур.%d: %d м, ловля ×%.2g"):format(l, Catalog.LanternRange[l], Catalog.LanternSpeed[l]),
		l < Catalog.MaxLevel and ("%d м, ×%.2g"):format(Catalog.LanternRange[l + 1], Catalog.LanternSpeed[l + 1]) or "")
	local j = state.jarLvl
	row(jarRow, jarBtn, j, ("Банка ур.%d: %d духа"):format(j, Catalog.JarCap[j]), j < Catalog.MaxLevel and ("%d"):format(Catalog.JarCap[j + 1]) or "")
end
local function doUpgrade(which)
	local r = remotes.Upgrade:InvokeServer(which)
	if r and r.ok then
		showToast(which == "lantern" and "Фонарь улучшен!" or "Банка стала вместительнее!")
		punch(which == "lantern" and lanternRow or jarRow)
	elseif r and r.msg then
		showToast(r.msg)
	end
end
lanternBtn.Activated:Connect(function() doUpgrade("lantern") end)
jarBtn.Activated:Connect(function() doUpgrade("jar") end)
collBtn.Activated:Connect(function()
	refreshCollection()
	collFrame.Visible = not collFrame.Visible
	upFrame.Visible = false
end)
upBtn.Activated:Connect(function()
	refreshUpgrades()
	upFrame.Visible = not upFrame.Visible
	collFrame.Visible = false
end)

local function refreshHUD()
	local icons = ""
	for i, k in state.jar do icons ..= (i == 1 and ": " or ", ") .. Catalog.Kinds[k].icon end
	jarLabel.Text = ("Банка %d/%d %s"):format(#state.jar, state.cap, icons)
	jarLabel.BackgroundColor3 = #state.jar >= state.cap and Color3.fromRGB(150, 60, 30) or Color3.fromRGB(20, 20, 40)
	infoLabel.Text = state.gardenOpen and ("Материал %d   Сад открыт"):format(state.materials)
		or ("Материал %d   Сад %d/%d"):format(state.materials, math.min(state.distinct, Catalog.GardenNeed), Catalog.GardenNeed)
	-- ворота сада: открыты локально, сервер всё равно проверяет доступ
	Barrier.CanCollide = not state.gardenOpen
	Barrier.Transparency = state.gardenOpen and 0.85 or 0.2
	if collFrame.Visible then refreshCollection() end
	if upFrame.Visible then refreshUpgrades() end
end

------------------------------------------------------------------ эффекты
local function ring(pos, fromSize, toSize, color, secs, upright)
	local r = Instance.new("Part")
	r.Shape, r.Anchored, r.CanCollide, r.CanQuery, r.CastShadow = Enum.PartType.Cylinder, true, false, false, false
	r.Material, r.Color, r.Transparency = Enum.Material.Neon, color, 0.15
	r.Size = Vector3.new(0.15, fromSize, fromSize)
	r.CFrame = CFrame.new(pos) * (upright and CFrame.Angles(0, math.rad(90), 0) or CFrame.Angles(0, 0, math.rad(90)))
	r.Parent = workspace
	TweenService:Create(r, TweenInfo.new(secs, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, toSize, toSize), Transparency = 1 }):Play()
	task.delay(secs + 0.05, function() r:Destroy() end)
end

local function burst(pos, colors, n)
	local a = Instance.new("Part")
	a.Anchored, a.CanCollide, a.CanQuery, a.Transparency, a.Size, a.Position = true, false, false, 1, Vector3.one, pos
	a.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Color = colors
	pe.Rate, pe.Lifetime, pe.Speed = 0, NumberRange.new(0.6, 1.1), NumberRange.new(8, 16)
	pe.SpreadAngle, pe.RotSpeed = Vector2.new(180, 180), NumberRange.new(-200, 200)
	pe.Size = NumberSequence.new(0.5, 0.1)
	pe.LightEmission, pe.Acceleration = 0.4, Vector3.new(0, -14, 0)
	pe.Parent = a
	pe:Emit(n)
	task.delay(1.5, function() a:Destroy() end)
end

local streak, lastCatch = 0, 0
local function catchEffect(kind, at, coop)
	local r = root()
	if not r then return end
	local info = Catalog.Kinds[kind]
	local rar = Catalog.Rarity[info.rarity]
	streak = (os.clock() - lastCatch < 20) and streak + 1 or 1
	lastCatch = os.clock()
	local m = Spirits.Builders[kind]()
	if kind == "GoldenCarp" then Spirits.scale(m, 0.6) end
	m.Parent = workspace
	local big = info.rarity ~= "common"
	local dur = big and 0.85 or 0.55
	ring(at + Vector3.new(0, 2, 0), big and 16 or 8, 2, rar.color, dur, true)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local p = math.min((os.clock() - t0) / dur, 1)
		local e = p * p
		local cr = root()
		local goal = cr and cr.Position + Vector3.new(0, -0.5, 0) or at
		local pos = at:Lerp(goal, e) + Vector3.new(0, math.sin(p * math.pi) * 4, 0)
		for _, part in m:GetChildren() do
			if part:IsA("BasePart") then part.Transparency = math.max(part.Transparency, e * 0.9) end
		end
		Spirits.animate(m, CFrame.new(pos) * CFrame.Angles(0, p * 12, 0), os.clock() * 15)
		if p >= 1 then
			conn:Disconnect()
			m:Destroy()
			burst(goal, ColorSequence.new(rar.color, Color3.new(1, 1, 1)), big and 50 or 22)
			ring(goal, 1, big and 12 or 6, rar.color, 0.35, false)
			punch(jarLabel)
		end
	end)
	local text = info.icon .. " " .. info.name .. " в банке!"
	if coop > 1 then text ..= ("  Совместная ловля ×%d"):format(coop)
	elseif streak > 1 then text ..= "  Серия ×" .. streak end
	if info.rarity == "legendary" then text = info.name .. "! Неси к алтарю" end
	showToast(text, 2.5)
end

-- раскрытие легендарного духа (~2 с): свет алтаря приглушён, тёмный силуэт сбоку от игрока → пауза →
-- световое кольцо → модель в цвете целиком в кадре, плывёт и оставляет золотой след
local revealCC = Instance.new("ColorCorrectionEffect")
revealCC.Parent = Lighting
local function dimAltar(on)
	for _, p in World:GetChildren() do
		if p:IsA("BasePart") and (p.Name == "AltarGlow" or p.Name == "AltarPillar" or p.Name == "AltarBeam") then
			local base = p:GetAttribute("BaseT") or p.Transparency
			p:SetAttribute("BaseT", base)
			TweenService:Create(p, TweenInfo.new(0.25), { Transparency = on and math.max(base, 0.85) or base }):Play()
			local l = p:FindFirstChildOfClass("PointLight")
			if l then
				local b = l:GetAttribute("BaseB") or l.Brightness
				l:SetAttribute("BaseB", b)
				TweenService:Create(l, TweenInfo.new(0.25), { Brightness = on and b * 0.15 or b }):Play()
			end
		end
	end
end
local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, -1)
end
local function revealLegendary(kind)
	local r = root()
	if not r then return end
	local cam = workspace.CurrentCamera
	local m = Spirits.Builders[kind]()
	Spirits.scale(m, 0.5)
	local orig = {}
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			orig[p] = { p.Color, p.Material, p.Transparency, p.Reflectance }
			if p.Name == "Fin" or p.Name == "Whisker" then
				p.Color, p.Material, p.Transparency = GOLD, Enum.Material.Neon, 0.35 -- подсвеченные плавники
			else
				p.Color, p.Material, p.Reflectance = Color3.fromRGB(8, 6, 12), Enum.Material.SmoothPlastic, 0
			end
		elseif p:IsA("Trail") or p:IsA("PointLight") then
			p.Enabled = false
		end
	end
	m.Parent = workspace
	dimAltar(true)
	TweenService:Create(revealCC, TweenInfo.new(0.2), { Brightness = -0.12, Saturation = -0.6 }):Play()
	local t0 = os.clock()
	local colored, ringed, restored = false, false, false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local cr = root() or r
		local right, fwd = flat(cam.CFrame.RightVector), flat(cam.CFrame.LookVector)
		-- сбоку от игрока, профилем к камере: видно всю модель
		local swim = t > 0.8 and (t - 0.8) * 2.2 or 0
		local pos = cr.Position + right * (7 - swim) + fwd * 3 + Vector3.new(0, 2.2 + math.sin(t * 3) * 0.25, 0)
		local pivot = CFrame.lookAt(pos, pos - right)
		Spirits.animate(m, pivot, t * (t > 0.8 and 5 or 1.5))
		if t > 0.5 and not ringed then
			ringed = true
			ring(pos, 2, 22, GOLD, 0.45, true)
		end
		if t > 0.7 and not colored then
			colored = true
			for p, o in orig do
				p.Material, p.Reflectance = o[2], o[4]
				TweenService:Create(p, TweenInfo.new(0.2), { Color = o[1], Transparency = o[3] }):Play()
			end
			for _, d in m:GetDescendants() do
				if d:IsA("Trail") or d:IsA("PointLight") then d.Enabled = true end
			end
			TweenService:Create(revealCC, TweenInfo.new(0.3), { Brightness = 0, Saturation = 0 }):Play()
		end
		if t > 1.75 and not restored then
			restored = true
			for p in orig do TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play() end
			dimAltar(false)
		end
		if t > 2.05 then
			conn:Disconnect()
			m:Destroy()
		end
	end)
	showToast(Catalog.Kinds[kind].name .. " в коллекции!", 2.5)
end

------------------------------------------------------------------ обучение (первая минута)
local tut = { step = 0 }
local TUT_TEXT = {
	"1/4  Найди фиолетовую тень у площади и наведи на неё фонарь",
	"2/4  Подойди и удерживай ЛОВИТЬ, пока дух не окажется в банке",
	"3/4  Отнеси улов к алтарю (голубой луч) и нажми «Сохранить улов»",
	"4/4  Открой «Коллекция» и экипируй лиса",
}
local arrowPart = Instance.new("Part")
arrowPart.Anchored, arrowPart.CanCollide, arrowPart.CanQuery, arrowPart.Transparency, arrowPart.Size = true, false, false, 1, Vector3.one
arrowPart.Parent = workspace
local arrowAtt = Instance.new("Attachment")
arrowAtt.Parent = arrowPart
local arrow = Instance.new("Beam")
arrow.Attachment1 = arrowAtt
arrow.Width0, arrow.Width1, arrow.FaceCamera, arrow.LightEmission = 0.6, 0.2, true, 1
arrow.Color = ColorSequence.new(Color3.fromRGB(140, 230, 255))
arrow.Transparency = NumberSequence.new(0.2, 0.6)
arrow.Enabled = false
arrow.Parent = arrowPart

local function setStep(n)
	tut.step = n
	if n >= 1 and n <= 4 then
		tutPanel.Text, tutPanel.Visible = TUT_TEXT[n], true
		punch(tutPanel)
	else
		tutPanel.Visible = false
		arrow.Enabled = false
	end
end
local function finishTutorial()
	if tut.step == 0 or tut.step == 5 then return end
	setStep(5)
	remotes.TutorialDone:FireServer()
	showToast("Обучение пройдено! Сохрани 3 разных духа — откроется Храмовый сад", 4)
end
skipBtn.Activated:Connect(finishTutorial)

------------------------------------------------------------------ серверные события
local firstState = true
remotes.State.OnClientEvent:Connect(function(s)
	state = s
	refreshHUD()
	if firstState then
		firstState = false
		if not s.tutorialDone then setStep(1) end
		if s.persistent == false then showToast("Сохранения недоступны в этом запуске", 3) end
	end
	if tut.step == 4 and s.equipped then finishTutorial() end
end)

remotes.SaveResult.OnClientEvent:Connect(function(r)
	if not r.ok then
		showToast(r.msg)
		return
	end
	local legendary
	for _, k in r.firsts do
		if Catalog.Kinds[k].rarity == "legendary" then legendary = k end
	end
	if legendary then
		revealLegendary(legendary)
	else
		local cr = root()
		if cr then
			ring(cr.Position + Vector3.new(0, 5, 0), 12, 1, COLD, 0.5, false)
			burst(cr.Position + Vector3.new(0, 2, 0), ColorSequence.new(COLD, Color3.new(1, 1, 1)), 30)
		end
		local msg = ("Сохранено духов: %d"):format(#r.kinds)
		if #r.firsts > 0 then msg ..= "  Новые: " .. #r.firsts end
		if r.gained > 0 then msg ..= ("  +%d материала"):format(r.gained) end
		if not r.persisted then msg ..= " (без DataStore)" end
		showToast(msg, 3)
	end
	if r.gardenOpened then
		task.delay(legendary and 2.3 or 1.2, function() showToast("Храмовый сад открыт! Иди на юг за канал", 4) end)
	end
	if tut.step == 3 then setStep(4) end
end)

remotes.Caught.OnClientEvent:Connect(function(kind, at, coop)
	catchEffect(kind, at, coop or 1)
	if tut.step == 2 or tut.step == 1 then setStep(3) end
end)

remotes.Hit.OnClientEvent:Connect(function(lost)
	vignette.BackgroundTransparency = 0.55
	TweenService:Create(vignette, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	showToast(lost > 0 and ("Они разбил банку! Потеряно духов: " .. lost) or "Они попал! Банка была пуста", 3)
end)
remotes.Notice.OnClientEvent:Connect(function(text) showToast(text, 2.5) end)

------------------------------------------------------------------ визуал духов
local visFolder = Instance.new("Folder")
visFolder.Name = "SpiritVisuals"
visFolder.Parent = workspace
local visuals = {}

local function addAnchor(a)
	if not a:IsA("BasePart") then return end
	local kind = a:GetAttribute("Kind")
	local info = kind and Catalog.Kinds[kind]
	if not info then return end
	local v = { anchor = a, kind = kind, info = info, seed = math.random() * 10 }
	if info.move ~= "swim" then
		v.shadow = Spirits.buildShadow(Catalog.Rarity[info.rarity].shadow)
		v.shadow.Parent = visFolder
	end
	visuals[a] = v
end
local function removeAnchor(a)
	local v = visuals[a]
	if not v then return end
	visuals[a] = nil
	if v.shadow then v.shadow:Destroy() end
	if v.model then v.model:Destroy() end
end
spiritsFolder.ChildAdded:Connect(addAnchor)
spiritsFolder.ChildRemoved:Connect(removeAnchor)
for _, a in spiritsFolder:GetChildren() do addAnchor(a) end

-- спутники всех игроков (видны всем)
local followers = {}
local function updateFollowers(now)
	for _, p in Players:GetPlayers() do
		local kind = p:GetAttribute("Companion")
		local f = followers[p]
		if f and f.kind ~= kind then
			f.model:Destroy()
			followers[p], f = nil, nil
		end
		local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if kind and kind ~= "" and Catalog.Kinds[kind] and r then
			if not f then
				local m = Spirits.Builders[kind]()
				Spirits.scale(m, Catalog.Kinds[kind].follow)
				m.Parent = visFolder
				f = { kind = kind, model = m, pivot = r.CFrame }
				followers[p] = f
			end
			local goal = r.CFrame * CFrame.new(3, 2.2 + math.sin(now * 2) * 0.4, 2)
			f.pivot = f.pivot:Lerp(goal, 0.1)
			Spirits.animate(f.model, f.pivot, now * Catalog.Kinds[kind].animSpeed * 0.6)
		elseif f then
			f.model:Destroy()
			followers[p] = nil
		end
	end
	for p, f in followers do
		if not p.Parent then
			f.model:Destroy()
			followers[p] = nil
		end
	end
end

-- они: модель строится у каждого клиента, сервер двигает опору
local oniModel, oniT = nil, 0
local function updateOni(dt)
	local a = workspace:FindFirstChild("Oni")
	if not a then
		if oniModel then oniModel:Destroy() oniModel = nil end
		return
	end
	if not oniModel then
		oniModel = Spirits.buildOni()
		oniModel.Parent = visFolder
	end
	local st = a:GetAttribute("State")
	local pose = CFrame.new()
	if st == "walk" then
		oniT += dt * 6
	elseif st == "windup" then
		pose = CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(math.sin(os.clock() * 40) * 0.15, 0, 0)
		oniT = math.pi / 2
	else
		pose = CFrame.new(0, 0, -1) * CFrame.Angles(math.rad(18), 0, 0)
		oniT = -math.pi / 2
	end
	Spirits.animate(oniModel, a.CFrame * pose, oniT)
end

------------------------------------------------------------------ фонарь и мягкое наведение
local highlight = Instance.new("Highlight")
highlight.FillTransparency, highlight.OutlineColor = 0.7, Color3.fromRGB(255, 230, 150)
highlight.Parent = visFolder

local target: BasePart? = nil
local aimTime, revealSent = 0, {}
local holding, holdId = false, nil

local function lanternRange()
	return Catalog.LanternRange[plr:GetAttribute("LanternLvl") or 1]
end

local function findTarget(r)
	local best, bestScore = nil, -math.huge
	local look = r.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	local range = lanternRange()
	for a, v in visuals do
		local d = a.Position - r.Position
		local dist = d.Magnitude
		local rng = v.info.move == "swim" and range + 8 or range
		if dist < rng and (v.anchor.Position.Z > -73 or state.gardenOpen) then
			local flat = Vector3.new(d.X, 0, d.Z)
			local dot = flat.Magnitude > 0.5 and flat.Unit:Dot(flatLook) or 1
			if dot > 0.7 or dist < 8 then
				local score = dot * 2 - dist / rng + (a:GetAttribute("Revealed") and 0.3 or 0)
				if score > bestScore then best, bestScore = a, score end
			end
		end
	end
	return best
end

local function release()
	if holding then
		holding = false
		remotes.CatchHold:FireServer(nil)
	end
end

local currentDistrict = nil
local districtCC = Instance.new("ColorCorrectionEffect")
districtCC.Parent = Lighting
local TINT = {
	street = Color3.fromRGB(255, 238, 220),
	plaza = Color3.fromRGB(235, 245, 255),
	canal = Color3.fromRGB(220, 240, 255),
	garden = Color3.fromRGB(230, 255, 235),
}

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	local r = root()

	-- фаза Красной луны
	local ends = workspace:GetAttribute("PhaseEnds")
	if ends then
		local left = math.max(0, math.floor(ends - workspace:GetServerTimeNow()))
		local timeStr = ("%d:%02d"):format(left // 60, left % 60)
		if workspace:GetAttribute("MoonActive") then
			banner.Text = "КРАСНАЯ ЛУНА " .. timeStr
			banner.BackgroundColor3, banner.BackgroundTransparency = Color3.fromRGB(130, 15, 25), 0.1
		else
			banner.Text = "До Красной луны " .. timeStr
			banner.BackgroundColor3, banner.BackgroundTransparency = Color3.fromRGB(20, 20, 40), 0.3
		end
	end

	-- духи: тени и проявленные модели
	for a, v in visuals do
		local cf = a.CFrame
		local revealed = a:GetAttribute("Revealed")
		local near = not r or (cf.Position - r.Position).Magnitude < 170
		if v.shadow then
			local g = Vector3.new(cf.X, 0.62, cf.Z)
			v.shadow.CFrame = CFrame.new(g) * CFrame.Angles(0, now * 0.8, math.rad(90))
			v.shadow.Transparency = revealed and 0.85 or 0.2 + math.sin(now * 3 + v.seed) * 0.1
		end
		if revealed and not v.model then
			v.model = Spirits.Builders[v.kind]()
			v.model.Parent = visFolder
			ring(cf.Position + Vector3.new(0, 1, 0), 2, 10, Catalog.Rarity[v.info.rarity].color, 0.4, false)
			local pe = v.shadow and v.shadow:FindFirstChildOfClass("ParticleEmitter")
			if pe then pe:Emit(25) pe.Rate = 3 end
		end
		if v.model and near then
			local t = now + v.seed
			Spirits.animate(v.model, cf * Spirits.Pose[v.kind](t), t * v.info.animSpeed)
		end
	end
	updateFollowers(now)
	updateOni(dt)
	if not r then return end

	-- район: подпись и оттенок света
	local d = Catalog.district(r.Position.Z)
	if d ~= currentDistrict then
		currentDistrict = d
		districtTitle.Text, districtTitle.Visible = Catalog.DistrictNames[d], true
		districtTitle.TextTransparency = 0
		TweenService:Create(districtTitle, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.6), { TextTransparency = 1 }):Play()
		TweenService:Create(districtCC, TweenInfo.new(1.5), { TintColor = TINT[d] }):Play()
	end
	local nearAltar = (r.Position - ALTAR_POS).Magnitude < 24
	upBtn.Visible = nearAltar
	if not nearAltar then upFrame.Visible = false end

	-- выбор цели и мягкое наведение луча
	local t = (holding and target and target.Parent) and target or findTarget(r)
	if t ~= target then target, aimTime = t, 0 end
	local lantern = plr.Character:FindFirstChild("Lantern")
	local weld = lantern and lantern:FindFirstChild("Weld")
	if weld then
		local goal = CFrame.new(0.9, 0.3, -0.9)
		if target and target.Parent then
			local localDir = r.CFrame:VectorToObjectSpace((target.Position - r.Position).Unit)
			goal = CFrame.lookAt(goal.Position, goal.Position + localDir)
		end
		weld.C0 = weld.C0:Lerp(goal, math.min(1, dt * 6))
	end

	highlight.Adornee, hint.Adornee = nil, nil
	local inRange = false
	if target and target.Parent and (r.Position - ALTAR_POS).Magnitude > 16 then
		local v = visuals[target]
		local id = target:GetAttribute("SpiritId")
		local dist = (target.Position - r.Position).Magnitude
		local rar = v and Catalog.Rarity[v.info.rarity]
		if target:GetAttribute("Revealed") then
			highlight.Adornee = v and v.model
			highlight.OutlineColor = rar and rar.color or Color3.new(1, 1, 1)
			inRange = v and dist < Catalog.catchRange(v.kind)
			hint.Adornee = target
			hint.StudsOffset = Vector3.new(0, 7, 0)
			local full = #state.jar >= state.cap
			local holders = target:GetAttribute("Holders") or 0
			if full then
				hintText.Text, hintText.TextColor3 = "Банка полна!", Color3.fromRGB(255, 160, 120)
			elseif holders > 1 then
				hintText.Text, hintText.TextColor3 = ("Ловим вместе ×%d"):format(holders), GOLD
			else
				hintText.Text = inRange and (v.info.name) or "Подойди ближе"
				hintText.TextColor3 = inRange and Color3.fromRGB(140, 255, 180) or Color3.new(1, 1, 1)
			end
			if tut.step == 1 then setStep(2) end
		elseif v then
			highlight.Adornee = v.shadow
			highlight.OutlineColor = rar.color
			hint.Adornee = target
			hint.StudsOffset = Vector3.new(0, 3, 0)
			local need = rar.revealTime / Catalog.LanternSpeed[plr:GetAttribute("LanternLvl") or 1]
			aimTime += dt
			hintText.Text = "Свети" .. string.rep(".", math.clamp(math.floor(aimTime / need * 3), 0, 3))
			hintText.TextColor3 = Color3.fromRGB(200, 170, 255)
			if aimTime > need and not revealSent[id] then
				revealSent[id] = true
				remotes.Reveal:FireServer(id)
			end
		end
	end

	-- кнопка ловли (прогресс считает сервер)
	catchBtn.Visible = inRange or holding
	if holding then
		if not inRange or not target or target:GetAttribute("SpiritId") ~= holdId then
			release()
		else
			local p = target:GetAttribute("Progress") or 0
			fill.Size = UDim2.new(1, 0, math.clamp(p, 0, 1), 0)
			catchBtn.Rotation = math.sin(now * 40) * 4 * p
			local holders = target:GetAttribute("Holders") or 0
			catchBtn.Text = holders > 1 and ("×" .. holders) or "ЛОВИТЬ"
		end
	end
	if not holding then
		fill.Size = UDim2.new(1, 0, 0, 0)
		catchBtn.Rotation = 0
		catchBtn.Text = #state.jar >= state.cap and "ПОЛНА" or "ЛОВИТЬ"
	end

	-- стрелка обучения
	if tut.step >= 1 and tut.step <= 3 then
		local goalPos
		if tut.step == 1 then
			local best, bd = nil, math.huge
			for a, v in visuals do
				if not a:GetAttribute("Revealed") and v.kind == "PaperFox" then
					local dd = (a.Position - r.Position).Magnitude
					if dd < bd then best, bd = a, dd end
				end
			end
			goalPos = best and best.Position
		elseif tut.step == 2 then
			goalPos = target and target.Parent and target.Position
		else
			goalPos = ALTAR_POS + Vector3.new(0, 2, 0)
		end
		local att = r:FindFirstChild("TutAtt")
		if not att then
			att = Instance.new("Attachment")
			att.Name = "TutAtt"
			att.Position = Vector3.new(0, -2, 0)
			att.Parent = r
		end
		arrow.Attachment0 = att
		arrow.Enabled = goalPos ~= nil and (goalPos - r.Position).Magnitude > 6
		if goalPos then arrowPart.Position = goalPos end
	elseif tut.step == 4 then
		arrow.Enabled = false
		collBtn.BackgroundColor3 = (math.floor(now * 3) % 2 == 0) and Color3.fromRGB(230, 160, 40) or Color3.fromRGB(70, 80, 160)
	else
		arrow.Enabled = false
		collBtn.BackgroundColor3 = Color3.fromRGB(70, 80, 160)
	end
end)

------------------------------------------------------------------ ввод
local function beginHold()
	local r = root()
	if not (r and target and target.Parent and target:GetAttribute("Revealed")) then return end
	if #state.jar >= state.cap then
		showToast("Банка полна — отнеси улов к алтарю")
		return
	end
	holding, holdId = true, target:GetAttribute("SpiritId")
	remotes.CatchHold:FireServer(holdId)
end
catchBtn.MouseButton1Down:Connect(beginHold)
catchBtn.MouseButton1Up:Connect(release)
catchBtn.MouseLeave:Connect(release)
remotes.Caught.OnClientEvent:Connect(function() holding = false end)
-- ПК/Studio: клавиша F
UserInputService.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.F then beginHold() end
end)
UserInputService.InputEnded:Connect(function(i)
	if i.KeyCode == Enum.KeyCode.F then release() end
end)

------------------------------------------------------------------ замер кадра и Bloom (только тестовый плейс / Studio)
local IS_TEST = RunService:IsStudio() or game.PlaceId == 99980756426085
if IS_TEST then
	local perf = label("", UDim2.new(0, 12, 0, 214), UDim2.new(0, 200, 0, 46), nil, 14)
	perf.BackgroundTransparency = 0.45
	local bloomBtn = button("", UDim2.new(0, 12, 0, 264), UDim2.new(0, 200, 0, 28), Color3.fromRGB(60, 60, 80))
	local PRESETS = { 0, 0.1, 0.2, 0.35 }
	local bi = 3
	local function applyBloom()
		local b = Lighting:FindFirstChild("Bloom")
		if b then b.Enabled = PRESETS[bi] > 0; b.Intensity = PRESETS[bi] end
		bloomBtn.Text = PRESETS[bi] > 0 and ("Bloom %.2f (нажми)"):format(PRESETS[bi]) or "Bloom выкл (нажми)"
	end
	applyBloom()
	bloomBtn.Activated:Connect(function()
		bi = bi % #PRESETS + 1
		applyBloom()
	end)
	local win, winN, winMax = 0, 0, 0
	local bridge = { night = { 0, 0, 0 }, moon = { 0, 0, 0 } } -- сумма, кадры, максимум
	local function fmt(b)
		return b[2] > 30 and ("%.1f/%.0f"):format(b[1] / b[2] * 1000, b[3] * 1000) or "-"
	end
	RunService.Heartbeat:Connect(function(dt)
		win += dt
		winN += 1
		winMax = math.max(winMax, dt)
		local r = root()
		if r and math.abs(r.Position.X) < 5 and r.Position.Z > -43 and r.Position.Z < -17 then
			local b = workspace:GetAttribute("MoonActive") and bridge.moon or bridge.night
			b[1] += dt
			b[2] += 1
			b[3] = math.max(b[3], dt)
		end
		if win >= 1 then
			perf.Text = ("Кадр %.1f мс (макс %.0f), %d FPS\nМост ср/макс мс: ночь %s | луна %s"):format(win / winN * 1000, winMax * 1000, winN, fmt(bridge.night), fmt(bridge.moon))
			win, winN, winMax = 0, 0, 0
		end
	end)
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>